# Optional per-run overrides for start.sh.
#
# cp .env.example .env   (the real .env is not tracked by git).
# Precedence: shell env > ./.env > start.sh defaults.

# --- Cluster ---

# Node count: 1, 2 or 3 (TP = 8 * NNODES).
NNODES=1

# This node's rank, 0..NNODES-1.
NODE_RANK=0

# IP of the rank-0 node; required when NNODES > 1.
# MASTER_ADDR=10.0.0.1

# Port for the multi-node rendezvous (--dist-init-addr); DIST_PORT+13 must also
# be open between nodes (attention-DP port handshake).
# DIST_PORT=20000

# NCCL network interface (also set as GLOO_SOCKET_IFNAME) if NCCL picks the wrong one.
# NCCL_SOCKET_IFNAME=eth0

# InfiniBand/RoCE HCAs for NCCL (prefix match), e.g. rdma for rdma_0..rdma_7.
# NCCL_IB_HCA=rdma

# NCCL log level; INFO shows which transport each link uses.
# NCCL_DEBUG=INFO

# --- GPU ---

# The node's 8 GPUs; exactly 8 are required.
GPU_ID=0,1,2,3,4,5,6,7

# --- API ---

# API bind address and port (served on rank 0 only).
HOST=0.0.0.0
PORT=30000

# --- Model ---

# HuggingFace model id.
# MODEL_ID=moonshotai/kimi-k3

# Name the API serves the model under.
# SERVED_MODEL_NAME=kimi-k3

# SGLang image.
# IMAGE=lmsysorg/sglang:latest

# HuggingFace cache on the host; default ~/.cache/huggingface.
# HF_CACHE=/data/huggingface

# Optional; a token only raises Hub rate limits.
# HF_TOKEN=

# --- Tuning ---

# --mem-fraction-static; default 0.82 on 1 node, 0.92 on 2/3 nodes.
# MEM_FRACTION=0.82

# If set, --context-length; otherwise the model default.
# CONTEXT_LENGTH=

# docker --shm-size.
# SHM_SIZE=32g

# Extra SGLang flags, appended last (override anything above).
# EXTRA_ARGS=
